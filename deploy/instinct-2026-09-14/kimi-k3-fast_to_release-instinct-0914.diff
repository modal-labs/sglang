+                {
+                    "type": "image_url",
+                    "image_url": {
+                        "url": warmup_image_data_url(
+                            WARMUP_IMAGE_WIDTH, WARMUP_IMAGE_HEIGHT
+                        )
+                    },
+                },
+            ],
+        }
+    ],
+    "max_tokens": 64,
+    "temperature": 0.7,
+}
